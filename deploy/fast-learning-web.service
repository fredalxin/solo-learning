[Unit]
Description=Fast Learning Web
After=network-online.target fast-learning-api.service
Wants=network-online.target
Requires=fast-learning-api.service

[Service]
Type=simple
WorkingDirectory=%h/fast-learning
Environment=NODE_ENV=production
Environment=ATLAS_API_PORT=8788
Environment=PATH=/data00/home/litengfei/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run preview -- --host 0.0.0.0 --port 5173
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
