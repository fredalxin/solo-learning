[Unit]
Description=Fast Learning API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/fast-learning
Environment=NODE_ENV=production
Environment=ATLAS_API_PORT=8788
Environment=PATH=/data00/home/litengfei/.local/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node server/index.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
