{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["outline"],
  "properties": {
    "outline": {
      "type": "array",
      "minItems": 1,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "sources", "level", "parent"],
        "properties": {
          "title": { "type": "string" },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "level": { "type": "string", "enum": ["main", "detail", "appendix", "overview"] },
          "parent": { "type": "integer", "minimum": -1, "maximum": 17 }
        }
      }
    }
  }
}
