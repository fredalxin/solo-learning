{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answerMode",
    "kicker",
    "title",
    "summary",
    "facts",
    "children"
  ],
  "properties": {
    "answerMode": {
      "type": "string",
      "enum": [
        "quick"
      ]
    },
    "kicker": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string",
      "minLength": 400
    },
    "facts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string"
        }
      }
    },
    "children": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    }
  }
}
